       "\[IndentingNewLine]", 
       RowBox[{"gccl", "=", 
        RowBox[{"GlobalClusteringCoefficient", "[", "rgw", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
