      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "\[LessEqual]", "ngraps"}], ",", 
      RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rgw", "=", 
        RowBox[{"Graph", "[", 
         RowBox[{
          RowBox[{"RandomGraph", "[", 
           RowBox[{"WattsStrogatzGraphDistribution", "[", 
